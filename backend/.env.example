DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/estoque_flex_dev

# Substitua por uma chave aleatória forte com pelo menos 32 bytes.
# Nunca utilize este valor de exemplo como chave real.
SECRET_KEY=replace-this-with-a-random-secret-key-of-at-least-32-bytes

# Origens autorizadas a consumir a API pelo navegador.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Banco auxiliar dedicado aos testes de autenticação.
TEST_AUTH_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/estoque_flex_auth_test
